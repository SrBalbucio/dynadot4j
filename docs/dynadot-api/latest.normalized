    {
      "RequestParameters": [
        {
          "description": "Currency of the auction. <div class='support-desc'><span class='support-title'>Supported values</span><span class='support-values'>usd, gbp, eur, inr, pln, zar, ltl, cny, cad, jpy, nzd, rub, aud, mxn, brl, idr, ars, cop, dkk, rsd, hkd, chf, aed, myr, ngn, kes, czk, btc, nok, thb, php, krw</span></div>",
