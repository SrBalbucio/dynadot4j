    {
      "RequestParameters": [
        {
          "description": "Forward type, it can be \"donot\": Do not forward email, \"mx\": Deliver email to another mail host (MX record), \"forward\": Deliver email to another mail host. <div class='support-desc'><span class='support-title'>Supported values</span><span class='support-values'>mtype_none, mtype_forward, mtype_mx</span></div>",
          "isOptional": false,
          "parameterName": "email_forward_type",
          "parameterType": "String"
        },
        {
          "description": "Only used when \"forwardType\" is \"forward\". ",
          "isOptional": true,
          "parameterName": "email_alias_list",
          "parameterType": "List<EmailAliasV2>",
          "subParameters": [
            {
              "description": "The user name of the email alias, only used when \"forward_type\" is \"forward\". ",
              "isOptional": true,
              "parameterName": "username",
              "parameterType": "String"
            },
            {
              "description": "The email address of the email alias, only used when \"forward_type\" is \"forward\". ",
              "isOptional": true,
              "parameterName": "email",
              "parameterType": "String"
            }
          ]
        },
        {
          "description": "Only used when \"forwardType\" is \"mx\". ",
          "isOptional": true,
          "parameterName": "email_exchange_list",
          "parameterType": "List<MailExchangeV2>",
          "subParameters": [
            {
              "description": "Mail host, only used when forward type is mx, only used when \"forward_type\" is \"mx\". ",
              "isOptional": true,
              "parameterName": "host",
              "parameterType": "String"
            },
            {
              "description": "Distance is the highest priority, only used when \"forward_type\" is \"mx\". ",
              "isOptional": true,
              "parameterName": "distance",
              "parameterType": "String"
            }
          ]
        }
      ],
