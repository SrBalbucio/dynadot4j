              "description": "The user name of the email alias, only used when \"forward_type\" is \"forward\". ",
              "isOptional": true,
              "parameterName": "username",
              "parameterType": "String"
            },
            {
              "description": "The email address of the email alias, only used when \"forward_type\" is \"forward\". ",
              "isOptional": true,
              "parameterName": "email",
              "parameterType": "String"
            }
          ]
        },
        {
          "description": "The mail exchange list you want to set. ",
          "isOptional": true,
          "parameterName": "email_exchange_list",
          "parameterType": "List<MailExchangeV2>",
          "subParameters": [
            {
              "description": "Mail host, only used when forward type is mx, only used when \"forward_type\" is \"mx\". ",
              "isOptional": true,
              "parameterName": "host",
              "parameterType": "String"
            },
            {
              "description": "Distance is the highest priority, only used when \"forward_type\" is \"mx\". ",
              "isOptional": true,
              "parameterName": "distance",
              "parameterType": "String"
            }
          ]
        }
