      "apiVersion": "v2",
      "commandName": "search",
      "requestDemoJson": {
        "requestBody": {
          "currency": "String",
          "show_price": false
        },
        "requestHeader": {
          "Accept": "application/json",
          "Authorization": "Bearer ",
          "Content-Type": "application/json",
          "Method": "GET",
          "URL": "https://api.dynadot.com/restful/v2/domains/{domain_name}/search"
        }
      },
      "supportApiSandbox": true
    },
    {
      "RequestParameters": [
        {
          "description": "Optional maximum waiting time for bulk search, in seconds. Valid range: 1-60 seconds. ",
          "isOptional": true,
          "parameterName": "timeout",
          "parameterType": "Integer"
        },
        {
          "description": "If you would like to display price for available search result. ",
          "isOptional": true,
          "parameterName": "show_price",
          "parameterType": "Boolean"
        },
        {
          "description": "The currency of the price result. <div class='support-desc'><span class='support-title'>Supported values</span><span class='support-values'>usd, gbp, eur, inr, pln, zar, ltl, cny, cad, jpy, nzd, rub, aud, mxn, brl, idr, ars, cop, dkk, rsd, hkd, chf, aed, myr, ngn, kes, czk, btc, nok, thb, php, krw</span></div>",
          "isOptional": true,
          "parameterName": "currency",
          "parameterType": "String"
        },
        {
          "description": "Specifies multiple domain names to be included in the bulk search request.Multiple domains must be listed as a single string, using commas (,) as separators, without any whitespace between entries.<br><br>The maximum number of domain names permitted in a single request is determined by the account's pricing tier:<br>Pricing Tier - Maximum Domains<br>Regular - 5<br>Bulk - 10<br>Super Bulk - 20<br><br><b>Example:</b><br><pre style=\"display: inline-block;width: 97%; margin: 0 0\">domain_name_list=example1.com,example2.net,example3.org</pre>. ",
          "isOptional": false,
          "parameterName": "domain_name_list",
          "parameterType": "List<String>"
        }
      ],
