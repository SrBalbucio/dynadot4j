    {
      "RequestParameters": [
        {
          "description": "The type of sale you want to set for the domain. <div class='support-desc'><span class='support-title'>Supported values</span><span class='support-values'>not_for_sale, marketplace, broker_service</span></div>",
          "isOptional": false,
          "parameterName": "for_sale_type",
          "parameterType": "String"
        },
        {
          "description": "The currency you want to set the domain for sale in. <div class='support-desc'><span class='support-title'>Supported values</span><ul class='support-values'><li>usd  :  { USD } </li><li>eur  :  { EUR } </li><li>cny  :  { CNY } </li><li>cad  :  { CAD } </li><li>mxn  :  { MXN } </li><li>gbp  :  { GBP } </li><li>brl  :  { BRL } </li><li>inr  :  { INR } </li><li>idr  :  { IDR } </li><li>aud  :  { AUD } </li><li>thb  :  { THB } </li><li>php  :  { PHP } </li><li>krw  :  { KRW } </li><li>hkd  :  { HKD } </li></ul></div>",
