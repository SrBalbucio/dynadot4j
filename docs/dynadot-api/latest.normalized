    {
      "RequestParameters": [
        {
          "description": "The email forwarding type you wish to configure email forwarding,\nMTYPE_NONE: Do not forward email,\nMTYPE_FORWARD: Deliver email to another mail host,\nMTYPE_MX: Deliver email to another mail host (MX record). <div class='support-desc'><span class='support-title'>Supported values</span><span class='support-values'>mtype_none, mtype_forward, mtype_mx</span></div>",
          "isOptional": false,
          "parameterName": "email_forward_type",
          "parameterType": "String"
        },
        {
          "description": "The email alias list you wish to configure email forwarding. ",
          "isOptional": true,
          "parameterName": "email_alias_list",
          "parameterType": "List<EmailAliasV2>",
          "subParameters": [
            {
              "description": "The user name of the email alias, only used when \"forward_type\" is \"forward\". ",
              "isOptional": true,
              "parameterName": "username",
              "parameterType": "String"
            },
            {
              "description": "The email address of the email alias, only used when \"forward_type\" is \"forward\". ",
              "isOptional": true,
              "parameterName": "email",
              "parameterType": "String"
            }
          ]
        },
        {
          "description": "The mail exchange list you wish to configure email forwarding. ",
          "isOptional": true,
          "parameterName": "email_exchange_list",
          "parameterType": "List<MailExchangeV2>",
          "subParameters": [
            {
              "description": "Mail host, only used when forward type is mx, only used when \"forward_type\" is \"mx\". ",
              "isOptional": true,
              "parameterName": "host",
              "parameterType": "String"
            },
            {
              "description": "Distance is the highest priority, only used when \"forward_type\" is \"mx\". ",
              "isOptional": true,
              "parameterName": "distance",
              "parameterType": "String"
            }
          ]
        },
        {
          "description": "Apply this setting to domains that will be moved to this folder in the future. ",
          "isOptional": true,
          "parameterName": "apply_for_future_domain",
          "parameterType": "Boolean"
        },
        {
          "description": "Synchronize the settings of all domains in this folder. ",
          "isOptional": true,
          "parameterName": "sync_setting_to_existing_domains_in_this_folder",
          "parameterType": "Boolean"
        }
      ],
