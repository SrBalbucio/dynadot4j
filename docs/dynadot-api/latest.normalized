d>\n</tr>\n\n<tr style=\"background:#eef1f4\">\n    <td style=\"padding:20px 22px;border-top:6px solid white\">aname</td>\n    <td style=\"padding:20px 22px;border-top:6px solid white\">hostname</td>\n    <td style=\"padding:20px 22px;border-top:6px solid white\">unused</td>\n    <td style=\"padding:20px 22px;border-top:6px solid white\">ftp.myhost.com</td>\n    <td style=\"padding:20px 22px;border-top:6px solid white\">a, aaaa, cname, forward, stealth</td>\n</tr>\n\n<tr style=\"background:#eef1f4\">\n    <td style=\"padding:20px 22px;border-top:6px solid white\">caa</td>\n    <td style=\"padding:20px 22px;border-top:6px solid white\">CA policy</td>\n    <td style=\"padding:20px 22px;border-top:6px solid white\">unused</td>\n    <td style=\"padding:20px 22px;border-top:6px solid white\">0 issue \"ca.example.com\"</td>\n    <td style=\"padding:20px 22px;border-top:6px solid white\">cname</td>\n</tr>\n\n<tr style=\"background:#eef1f4\">\n    <td style=\"padding:20px 22px;border-top:6px solid white\">txt</td>\n    <td style=\"padding:20px 22px;border-top:6px solid white\">text value</td>\n    <td style=\"padding:20px 22px;border-top:6px solid white\">unused</td>\n    <td style=\"padding:20px 22px;border-top:6px solid white\">v=spf1 include:example.com ~all</td>\n    <td style=\"padding:20px 22px;border-top:6px solid white\">cname</td>\n</tr>\n\n<tr style=\"background:#eef1f4\">\n    <td style=\"padding:20px 22px;border-top:6px solid white\">forward</td>\n    <td style=\"padding:20px 22px;border-top:6px solid white\">hostname</td>\n    <td style=\"padding:20px 22px;border-top:6px solid white\">redirect type (301/302)</td>\n    <td style=\"padding:20px 22px;border-top:6px solid white\">https://www.myhost.com</td>\n    <td style=\"padding:20px 22px;border-top:6px solid white\">a, aaaa, aname, cname, stealth</td>\n</tr>\n\n<tr style=\"background:#eef1f4\">\n    <td style=\"padding:20px 22px;border-top:6px solid white\">stealth</td>\n    <td style=\"padding:20px 22px;border-top:6px solid white\">URL</td>\n    <td style=\"padding:20px 22px;border-top:6px solid white\">page title</td>\n    <td style=\"padding:20px 22px;border-top:6px solid white\">https://www.myhost.com</td>\n    <td style=\"padding:20px 22px;border-top:6px solid white\">a, aaaa, aname, cname, forward</td>\n</tr>\n\n<tr style=\"background:#eef1f4\">\n    <td style=\"padding:20px 22px;border-top:6px solid white\">mx</td>\n    <td style=\"padding:20px 22px;border-top:6px solid white\">mail server hostname</td>\n    <td style=\"padding:20px 22px;border-top:6px solid white\">priority (0-65535)</td>\n    <td style=\"padding:20px 22px;border-top:6px solid white\">smtp.myhost.com / 10</td>\n    <td style=\"padding:20px 22px;border-top:6px solid white\">cname, email</td>\n</tr>\n\n<tr style=\"background:#eef1f4\">\n    <td style=\"padding:20px 22px;border-top:6px solid white\">email</td>\n    <td style=\"padding:20px 22px;border-top:6px solid white\">email address</td>\n    <td style=\"padding:20px 22px;border-top:6px solid white\">alias</td>\n    <td style=\"padding:20px 22px;border-top:6px solid white\">user@example.com</td>\n    <td style=\"padding:20px 22px;border-top:6px solid white\">cname, mx</td>\n</tr>\n\n<tr style=\"background:#eef1f4;border-top:6px solid white\">\n    <td style=\"padding:20px 22px;border-top:6px solid white\">srv</td>\n    <td style=\"padding:20px 22px;;border-top:6px solid white; color:#6b7280;font-style:italic\" colspan=\"4\">\n        Not supported for main DNS.\n    </td>\n</tr>\n\n<tr style=\"background:#eef1f4\">\n   <td style=\"padding:20px 22px;border-top:6px solid white\">ns</td>\n   <td style=\"padding:20px 22px;border-top:6px solid white;color:#6b7280;font-style:italic\" colspan=\"4\">\n         Not supported for main DNS.\n   </td>\n</tr>\n\n</tbody>\n</table>\n. <div class='support-desc'><span class='support-title'>Supported values</span><span class='support-values'>a, cname, forward, aaaa, txt, stealth, mx, email, caa, aname, ns, srv</s