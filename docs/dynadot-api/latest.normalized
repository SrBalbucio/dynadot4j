              "description": "The price for low-priority processing. Only present when high-priority processing is available for this backorder; empty or null otherwise. ",
              "isOptional": true,
              "parameterName": "low_priority_price",
              "parameterType": "String"
            },
            {
              "description": "The price for high-priority processing. Only present when high-priority processing is available for this backorder; empty or null otherwise. ",
              "isOptional": true,
