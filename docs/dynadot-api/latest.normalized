          "description": "Additional contact information applicable to the .ca TLD. ",
          "isOptional": false,
          "parameterName": "contact_extension",
          "parameterType": "Object",
          "subParameters": [
            {
              "description": "The WHOIS type indicating the classification of the domain registrant. <div class='support-desc'><span class='support-title'>Supported values</span><ul class='support-values'><li>citizen_with_privacy  :  { Canadian citizen, use CIRA WHOIS privacy } </li><li>citizen  :  { Canadian citizen } </li><li>pr_with_privacy  :  { Permanent Resident of Canada, use CIRA WHOIS privacy } </li><li>pr  :  { Permanent Resident of Canada } </li><li>corporation  :  { Corporation (Canada or Canadian province or territory) } </li><li>government  :  { Government or government entity in Canada } </li><li>educational  :  { Canadian Educational institution } </li><li>unincorporated_association  :  { Canadian Unincorporated Association } </li><li>hospital  :  { Canadian Hospital } </li><li>partnership  :  { Partnership Registered in Canada } </li><li>trademark_domain  :  { Domain contains Trade-mark registered in Canada (by a non-Canadian owner) } </li><li>trade_union  :  { Canadian Trade union } </li><li>political_party  :  { Canadian Political party } </li><li>library_museum  :  { Canadian Library, Archive or Museum } </li><li>trust  :  { Trust established in Canada } </li><li>aboriginal_people_with_privacy  :  { Aboriginal Peoples (individuals or groups) indigenous to Canada, use CIRA WHOIS privacy } </li><li>aboriginal_people  :  { Aboriginal Peoples (individuals or groups) indigenous to Canada } </li><li>indian_band  :  { Indian Band recognized by the Indian Act of Canada } </li><li>legal_representative_with_privacy  :  { Legal Representative of a Canadian Citizen or Permanent Resident, use CIRA WHOIS privacy } </li><li>legal_representative  :  { Legal Representative of a Canadian Citizen or Permanent Resident } </li><li>official_mark  :  { Official mark registered in Canada } </li><li>queen  :  { Her Majesty the Queen } </li></ul></div>",
              "isOptional": false,
              "parameterName": "whois_type",
              "parameterType": "String"
            },
            {
              "description": "Language preference for communication with CIRA during .CA domain registration. <div class='support-desc'><span class='support-title'>Supported values</span><span class='support-values'>english, french</span></div>",
              "isOptional": false,
              "parameterName": "cira_language",
              "parameterType": "String"
            },
            {
              "description": "Whether the user agrees to the CIRA registration agreement for .CA domains. Must be true to proceed. ",
              "isOptional": false,
              "parameterName": "accept_cira_agreement",
              "parameterType": "Boolean"
            },
            {
              "description": "The TLD of this contact extension. ",
              "isOptional": false,
              "parameterName": "tld",
              "parameterType": "String"
            }
          ]
        }
      ],
