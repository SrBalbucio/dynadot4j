      "apiVersion": "v2",
      "commandName": "get_open_auctions",
      "requestDemoJson": {
        "requestBody": {
          "auction_types": [
            "String"
          ],
          "currency": "String",
          "has_bids": false,
          "page": 0,
          "page_size": 0,
          "sort": "String"
        },
        "requestHeader": {
          "Accept": "application/json",
          "Authorization": "Bearer ",
          "Content-Type": "application/json",
          "Method": "GET",
          "URL": "https://api.dynadot.com/restful/v2/aftermarket/auctions/open"
        }
      },
      "supportApiSandbox": false
    },
    {
      "RequestParameters": [
        {
          "description": "The currency for the auction. If not provided, the account's default API currency will be used. <div class='support-desc'><span class='support-title'>Supported values</span><ul class='support-values'><li>usd  :  { USD } </li><li>eur  :  { EUR } </li><li>cny  :  { CNY } </li><li>cad  :  { CAD } </li><li>mxn  :  { MXN } </li><li>gbp  :  { GBP } </li><li>brl  :  { BRL } </li><li>inr  :  { INR } </li><li>idr  :  { IDR } </li><li>aud  :  { AUD } </li><li>thb  :  { THB } </li><li>php  :  { PHP } </li><li>krw  :  { KRW } </li><li>hkd  :  { HKD } </li></ul></div>",
          "isOptional": true,
          "parameterName": "currency",
          "parameterType": "String"
        },
        {
          "description": "The starting price for the auction in the smallest currency unit (e.g. cents). For example, 1000 represents 10.00. Must be a positive integer. ",
          "isOptional": false,
          "parameterName": "starting_price",
          "parameterType": "Long"
        },
        {
          "description": "The description for the auction. It is optional and can be up to 1000 characters. ",
          "isOptional": true,
          "parameterName": "description",
          "parameterType": "String"
        },
        {
          "description": "The Google Analytics ID for tracking the auction performance. It is optional and should be in the format of UA-XXXXX-Y. ",
          "isOptional": true,
          "parameterName": "google_analytics_id",
          "parameterType": "String"
        },
        {
          "description": "Whether to automatically relist the auction if it expires without a sale. It is optional and defaults to false. ",
          "isOptional": true,
          "parameterName": "auto_relist",
          "parameterType": "Boolean"
        },
        {
          "description": "Whether the auction can be purchased with installment payment. It is optional and defaults to false. ",
          "isOptional": true,
          "parameterName": "can_installment",
          "parameterType": "Boolean"
        },
        {
          "description": "The maximum installment month allowed for the auction if can_installment is true. It is optional and should be a positive integer. If not provided, it will default to 2 months. ",
          "isOptional": true,
          "parameterName": "max_installment_month",
          "parameterType": "Integer"
        },
        {
          "description": "Whether to revert to the previous DNS settings after the auction ends. It is optional and defaults to false. ",
          "isOptional": true,
          "parameterName": "revert_previous_dns",
          "parameterType": "Boolean"
        }
      ],
