          "parameterName": "currency",
          "parameterType": "String"
        },
        {
          "description": "Multiple values can be provided, separated by ','. <div class='support-desc'><span class='support-title'>Supported values</span><span class='support-values'>expired, user, portfolio, backorder, registrar, registry, registryexpired, premiumuser, preexpiry</span></div>",
          "isOptional": true,
          "parameterName": "auction_types",
          "parameterType": "List"
        },
        {
          "description": "Number of records to return per page, and cannot be greater than 100. ",
