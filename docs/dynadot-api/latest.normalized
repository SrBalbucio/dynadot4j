      "RequestParameters": [
        {
          "description": "The type of email forwarding you want to set. <div class='support-desc'><span class='support-title'>Supported values</span><span class='support-values'>mtype_none, mtype_forward, mtype_mx</span></div>",
          "isOptional": false,
          "parameterName": "email_forward_type",
          "parameterType": "String"
        },
        {
          "description": "The email alias list you want to set. ",
          "isOptional": true,
          "parameterName": "email_alias_list",
          "parameterType": "List<EmailAliasV2>",
          "subParameters": [
